# QUESTR — Docker build context exclusions (applies to the BACKEND Dockerfile,
# whose context is the repo root). The frontend and kafka services are
# self-contained directories with their own contexts/.dockerignore files.

# Maven build output (copied from inside the build stage instead)
target/

# Source control
.git/
.gitignore

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/

# Other services — the backend image doesn't need these, and excluding them
# keeps the build context lean and prevents any stray env files leaking in.
frontend/
kafka/

# Docker files (no recursive COPY needed)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Dev environment
.env
*.env
!.env.example

# Documentation & plans
*.md
*.txt
plan.txt

# Logs & OS artefacts
logs/
*.log
.DS_Store

# GitHub CI
.github/

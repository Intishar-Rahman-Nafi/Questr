# QUESTR — Docker build context exclusions
# Keeps Docker build context lean: only pom.xml + src/ are needed.

# Maven build output (copied from inside the build stage instead)
target/

# Source control
.git/
.gitignore

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/

# Docker files (no recursive COPY needed)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Dev environment
.env
*.env
!.env.example

# Frontend build artifacts only — frontend/ itself MUST stay included because
# frontend/Dockerfile (context = repo root) needs frontend/src, package.json, etc.
frontend/node_modules/
frontend/dist/

# Documentation & plans
*.md
*.txt
plan.txt

# Logs & OS artefacts
logs/
*.log
.DS_Store

# GitHub CI
.github/

# (nginx/ is intentionally NOT excluded — frontend/Dockerfile needs
# nginx/nginx.conf from the build context to bake it into the image)


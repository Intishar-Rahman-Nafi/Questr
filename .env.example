# ─────────────────────────────────────────────────────────────────────────────
# QUESTR — Environment Variables Reference
# Copy this file to .env and fill in the values BEFORE starting the app.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=questr_db
DB_USER=admin
DB_PASSWORD=change_me_in_production

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use: openssl rand -base64 64
JWT_SECRET=replace-with-strong-random-secret-minimum-32-chars
JWT_EXPIRATION_MS=86400000       # 24 hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080


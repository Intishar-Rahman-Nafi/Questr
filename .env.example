# ─────────────────────────────────────────────────────────────────────────────
# QUESTR — Environment Variables Reference
# Copy this file to .env and fill in the values BEFORE starting the app.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
# Docker Compose maps Postgres to host port 5433 (avoids conflicts with any
# local Postgres on 5432). Change to 5432 if connecting to a local install.
DB_PORT=5433
DB_NAME=questr_db
DB_USER=admin
DB_PASSWORD=change_me_in_production

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use: openssl rand -base64 64
JWT_SECRET=replace-with-strong-random-secret-minimum-32-chars
JWT_EXPIRATION_MS=86400000       # 24 hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Frontend build-time config (used by frontend/Dockerfile) ────────────────
# Leave EMPTY for production — the frontend then calls relative /api/...
# paths, which Nginx reverse-proxies to the backend container (see
# nginx/nginx.conf). Only set this if frontend/backend are on different
# domains entirely.
VITE_API_BASE_URL=

# ── Module 10 — docker-compose.prod.yml only ─────────────────────────────────
# In production DB_HOST/DB_PORT/REDIS_HOST are NOT read from this file — they
# are hardcoded to the internal Docker service names (postgres:5432, redis:6379)
# directly inside docker-compose.prod.yml, since backend/postgres/redis all run
# on the same private "questr-net" Docker network. Only DB_NAME/DB_USER/
# DB_PASSWORD/REDIS_PASSWORD/JWT_SECRET/OPENAI_API_KEY are actually consumed
# in production — the DB_HOST/DB_PORT/REDIS_HOST values above are for LOCAL
# (non-Docker) development only.
